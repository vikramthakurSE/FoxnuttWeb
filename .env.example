# ── Database (Supabase → Connect → Connection string → Transaction pooler)
# If your password contains @ : / ? # [ ] % it must be percent-encoded,
# e.g. @ becomes %40 and # becomes %23, or the URL will not parse.
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres

# ── Session signing secret — any long random string
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-string

# ── Salesforce External Client App (Client Credentials flow)
SF_INSTANCE_URL=https://nirvanachores-dev-ed.develop.my.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=

# ── Secret for the retry cron endpoint (/api/cron/sync-orders)
CRON_SECRET=change-me-too

# ── Cashfree Verification Suite (GSTIN check for first-time B2B buyers)
# Dashboard → Verification Suite → API Keys. Access is granted after a
# sales conversation, not self-serve — see GO-LIVE.md.
# Leave both unset to run with the GSTIN gate "soft failing open": new
# buyers can still order, just always flagged for manual review.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
# Only needed if Cashfree's docs turn out to use a different host/path
# than https://api.cashfree.com/api/v2/verification/gstin once you test it.
CASHFREE_VERIFICATION_BASE_URL=

# ── UPI details for the "pay your pending balance first" screen.
# The QR image lives at public/pay/phonepe-qr.png, and the one-tap "Pay in
# UPI app" button defaults to the UPI ID decoded from that QR. Only set
# these if the receiving account changes.
NEXT_PUBLIC_UPI_VPA=
NEXT_PUBLIC_UPI_PAYEE=

# ── Local walkthrough with no database and no Salesforce.
# MUST stay false (or unset) in production — it accepts orders that go
# nowhere. It only engages when DATABASE_URL is absent, as a second guard.
DEMO_MODE=false

# Note: clients log in with the Unique_Business_Code__c that Salesforce
# issues them and that their welcome WhatsApp carries, so the website itself
# sends no WhatsApp messages and needs no Meta credentials. Order and status
# messages are still sent from Salesforce, using WhatsApp_Config__mdt there.
