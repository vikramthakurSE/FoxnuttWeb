# ── Database (Supabase → Project Settings → Database → Connection string, URI)
DATABASE_URL=postgres://user:password@host:5432/postgres

# ── Session signing secret — any long random string
SESSION_SECRET=change-me-to-a-long-random-string

# ── Salesforce Connected App (Client Credentials flow)
SF_INSTANCE_URL=https://nirvanachores-dev-ed.develop.my.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=

# ── WhatsApp Cloud API (same values as WhatsApp_Config__mdt in Salesforce)
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
# Meta 'authentication' category template used for the OTP message
WA_OTP_TEMPLATE=nn_login_code
# Set to false only if your approved template has NO copy-code button
WA_OTP_BUTTON=true

# Set to "true" while the OTP template is not yet approved —
# the code is printed in the server console instead of being sent.
OTP_DEV_MODE=false

# Local walkthrough with no database and no Salesforce. MUST stay false
# (or unset) in production — it accepts orders that go nowhere.
DEMO_MODE=false

# Secret for the retry cron endpoint (/api/cron/sync-orders)
CRON_SECRET=change-me-too
